# ----------------------------------------------------------------------------
# cHackerBlog runtime configuration. Copy to `.env` and adjust.
# All values are validated by src/lib/env.ts (zod). Invalid env fails fast.
# ----------------------------------------------------------------------------

# --- Core ---
NODE_ENV=development
APP_URL=http://localhost:3000

# --- Logging ---
# Log level: trace, debug, info, warn, error, silent
# Defaults: trace for development, error for production
# Override with LOG_LEVEL to set a specific level
LOG_LEVEL=
# Log to console (true/false, default: true)
LOG_TO_CONSOLE=true
# Log to file (true/false, default: true)
LOG_TO_FILE=true
# Log directory for file output (default: ./logs)
LOG_DIR=./logs
# Log filename (default: app.log)
LOG_FILE=app.log

# --- Database ---
# Local development uses SQLite; production uses PostgreSQL.
# Set DATABASE_PROVIDER to "sqlite" or "postgresql" (must match prisma generate).
DATABASE_PROVIDER=sqlite
DATABASE_URL="file:./dev.db"
# Example production value:
# DATABASE_PROVIDER=postgresql
# DATABASE_URL="postgresql://user:pass@host:5432/chackerblog?schema=public"

# --- Admin auth ---
# Plaintext is hashed on first boot if ADMIN_PASSWORD_HASH is empty.
# Prefer setting ADMIN_PASSWORD_HASH (bcrypt) in production.
ADMIN_PASSWORD=changeme
ADMIN_PASSWORD_HASH=
# Secret used to sign the admin session cookie.
SESSION_SECRET=replace-with-a-long-random-string

# --- Redis (ioredis) ---
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=chb:

# --- Cache durations (seconds) ---
CACHE_TTL_GLOBAL_SETTINGS=300
CACHE_TTL_ARTICLE=120
CACHE_TTL_FEED=30
# Article translations are stable per revision (invalidated on edit/delete).
CACHE_TTL_TRANSLATION=86400

# --- Rate limiting ---
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100
# When true, trust Cloudflare's CF-Connecting-IP header for the real client IP.
TRUST_CLOUDFLARE=true

# --- Feed / infinite scroll ---
# How many articles to fetch per page (prefetched in advance for performance).
FEED_PAGE_SIZE=5
# How many pages to prefetch ahead of the scroll position.
FEED_PREFETCH_PAGES=1
# How many leading articles render fully expanded at the top of the feed.
FEED_EXPANDED_COUNT=1
# Set to true to expand ALL articles in the feed (overrides FEED_EXPANDED_COUNT)
FEED_EXPAND_ALL=false
# How many characters to show in feed preview (truncated from full content)
FEED_PREVIEW_CHARS=200
# Feed expansion ratio (0-1): 1 = full screen like Medium, 0.5 = half screen
FEED_EXPANSION_RATIO=0.5

# --- Theme ---
# Theme preset: hacker, medium, or substack. Colors and fonts live in SCSS
# (src/styles/themes/*), emitted as [data-theme="…"] CSS custom properties.
THEME=hacker
# Code syntax-highlighting theme: any highlight.js stylesheet name, e.g.
# github, monokai, nord, atom-one-dark, dracula, tokyo-night-dark, vs2015.
# The default "github" auto-switches to "github-dark" on dark site themes
# (hacker) and stays light "github" on light themes (medium / substack).
CODE_THEME=github

# --- Mailer (nodemailer SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="cHackerBlog <noreply@example.com>"

# --- IP geolocation provider ---
# Endpoint receiving {ip} substitution, e.g. https://ipapi.co/{ip}/json/
IPGEO_ENDPOINT=https://ipapi.co/{ip}/json/

# --- Social auto-posting (optional; enabled if creds present) ---
SOCIAL_AUTOPOST_ENABLED=false
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=

# --- Grok (x.ai) translation (optional; enabled only if GROK_API_KEY is set) ---
# When set, articles gain a "show translation" toggle that translates the body
# and title on demand via the Grok API, caching + persisting the result.
GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
# Must be a model your API key can access. "grok-2-latest" is deprecated and
# returns HTTP 400; "grok-4.3" (alias "grok-latest") is current. See
# https://docs.x.ai/developers/models
GROK_MODEL=grok-4.3
# Sampling temperature (0-2). Lower = more literal/consistent translations.
GROK_TEMPERATURE=0.2
# Max characters per chunk when splitting article markdown for translation.
# Chunks are split on line boundaries and never through code blocks/embeds.
GROK_CHUNK_SIZE=1000
# Global rate limit for Grok API calls per day (resets at midnight UTC).
GROK_RATE_LIMIT_DAY=100
# Generic, tunable prompt templates. Placeholders substituted at call time:
#   {sourceLang} {targetLang} {sourceLocale} {targetLocale} {content}
# Edit these to steer tone, formality, or glossary handling. Leave blank to use
# the built-in defaults from src/lib/env.ts.
GROK_TRANSLATION_PROMPT=
GROK_TITLE_PROMPT=

# --- Uploads ---
UPLOAD_DIR=./public/uploads
# Max upload size (supports K, M, G suffixes, e.g., 200M, 1G, 500K)
UPLOAD_MAX_SIZE=200M

# --- Comments ---
# Set to false to disable commenting across the site
COMMENTS_ENABLED=true

# --- Internationalization ---
# Kill-switch: when true the site is forced to English, the /[lang]/... URL
# scheme is disabled (404), and the footer language switcher is hidden.
# Article-level Grok translation is unaffected.
DISABLE_I18N=false
