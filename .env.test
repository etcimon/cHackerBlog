# Test environment configuration
NODE_ENV=development
APP_URL=http://localhost:3000

# Test database (separate from development)
DATABASE_PROVIDER=sqlite
DATABASE_URL="file:./test.sqlite"

# Admin auth for tests
ADMIN_PASSWORD=changeme
ADMIN_PASSWORD_HASH=
SESSION_SECRET=test-secret-for-testing-only

# Cache/KV backend: force in-memory so tests never import or connect to Redis.
# With CACHE_DRIVER=memory, lib/kv.ts never imports lib/redis.ts (see kv.ts).
CACHE_DRIVER=memory
REDIS_KEY_PREFIX=test:

# Cache durations (minimal for tests to avoid stale data)
CACHE_TTL_GLOBAL_SETTINGS=1
CACHE_TTL_ARTICLE=1
CACHE_TTL_FEED=1

# Rate limiting (disabled for tests)
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=1000
TRUST_CLOUDFLARE=false

# Feed settings
FEED_PAGE_SIZE=20
FEED_PREFETCH_PAGES=0
FEED_EXPANDED_COUNT=1
FEED_EXPAND_ALL=false
FEED_PREVIEW_CHARS=200
FEED_EXPANSION_RATIO=0.5

# Theme
THEME=hacker

# Mailer (disabled for tests)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Test <test@example.com>"

# IP geolocation (disabled for tests)
IPGEO_ENDPOINT=

# Grok translation (test key/base so request-shaping can be asserted offline;
# the network call itself is never made in unit tests — it is mocked/recorded).
GROK_API_KEY=test-grok-key
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-2-latest
GROK_TEMPERATURE=0.2
GROK_CHUNK_SIZE=500

# Social auto-posting (disabled for tests)
SOCIAL_AUTOPOST_ENABLED=false
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=

# Uploads
UPLOAD_DIR=./public/test-uploads
UPLOAD_MAX_SIZE=200M

# Comments (enabled for tests)
COMMENTS_ENABLED=true

# Logging (verbose for tests)
LOG_LEVEL=trace
LOG_TO_CONSOLE=true
LOG_TO_FILE=false
LOG_DIR=./test-logs
LOG_FILE=test.log
